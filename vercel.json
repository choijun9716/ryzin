{
  "framework": null,
  "redirects": [
    {
      "source": "/shop",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/admin0",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/admin0/(.*)",
      "destination": "/admin/$1",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/live",
      "has": [
        { "type": "query", "key": "id" }
      ],
      "destination": "/live/:id",
      "permanent": true
    },
    {
      "source": "/live/",
      "has": [
        { "type": "query", "key": "id" }
      ],
      "destination": "/live/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/paystmt.html",
      "destination": "/api/paystmt"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/live/:id([^.]+)",
      "destination": "/api/live"
    }
  ]
}
