{
  "framework": null,
  "redirects": [
    {
      "source": "/shop",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/admin0",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/admin0/(.*)",
      "destination": "/admin/$1",
      "permanent": true
    },
    {
      "source": "/ryzin-ops-gate",
      "destination": "/ryzin-ops-gate/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/live",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/live/:id",
      "permanent": true
    },
    {
      "source": "/live/",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/live/:id",
      "permanent": true
    },
    {
      "source": "/live",
      "destination": "/live/N45ZMPL",
      "permanent": false
    },
    {
      "source": "/live/",
      "destination": "/live/N45ZMPL",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/paystmt.html",
      "destination": "/api/paystmt"
    },
    {
      "source": "/ryzin-ops-gate/assets/(.*)",
      "destination": "/admin/assets/$1"
    },
    {
      "source": "/ryzin-ops-gate/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|json|html|webp))",
      "destination": "/admin/$1"
    },
    {
      "source": "/ryzin-ops-gate/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/ryzin-ops-gate",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/live/:id([^.]+)",
      "destination": "/api/live"
    }
  ]
}