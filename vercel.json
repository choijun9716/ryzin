{
  "framework": null,
  "redirects": [
    {
      "source": "/shop",
      "destination": "/shop/",
      "permanent": true
    },
    {
      "source": "/admin0",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/admin0/(.*)",
      "destination": "/admin/$1",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/live",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/live/:id",
      "permanent": true
    },
    {
      "source": "/live/",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/live/:id",
      "permanent": true
    },
    {
      "source": "/live",
      "destination": "/live/N45ZMPL",
      "permanent": false
    },
    {
      "source": "/live/",
      "destination": "/live/N45ZMPL",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/paystmt.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/paystmt.html",
      "destination": "/api/paystmt"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/live/:id([^.]+)",
      "destination": "/api/live"
    }
  ]
}